/*
 * som-35d1f-255gs.dtsi - Device Tree file for the SOM-35D1F w/ 255GS EMAC Carrier.
 *
 * Copyright (C) 2023 EMAC Inc.
 *
 */

/dts-v1/;
#include "som35d1f.dtsi"

/ {
	model = "EMAC SOM-35D1F with SOM-255";
	compatible = "emac,som35d1f-255gs", "emac,som35d1f", "nuvoton,ma35d1";
	// display reserved-memoryhandled in panel dts file

	reg_1p5v: regulator0 {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.5V";
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_1p8v: regulator1 {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3_vcc: regulator2 {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	// Networking
	wlan_en_reg: regulator-wlan-en {
		compatible = "regulator-fixed";
		regulator-name = "wlan-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio_expander 1 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <70000>;
		enable-active-high;
		regulator-always-on;
	};


};

&gpio_expander {
	gpio-line-names =
		"BK_ON_OFF", "WIFI_EN", "BT_EN", "GPIO_INT_A",
		"GPIO_INT_B", "CAM1_IO0", "CAM1_IO1", "USB_OTG_INT#",
		"HALF_DUP", "LVDS_2VE", "HNDY_GPIO_10", "BUZZER",
		"IRQ0", "IRQ1", "", "" ;
};

// handle this in the panel dts
&gc520l {
	status = "disabled";
};

// handle this in the panel dts
&vc8k {
	status = "disabled";
};

// handle this in the panel dts
&tsc2004 {
	status = "disabled";
};

&gmac1 {
	phy-mode = "rmii";
	phy-handle = <&eth_phy1>;
	emac-phy-reset = <&gpio_expander_on_carrier 10 GPIO_ACTIVE_HIGH>;
	status = "okay";
	mdio1: mdio{
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		eth_phy1: ethernet-phy@1{
			compatible = "ethernet-phy-id0007.0570";
			vsc8531,vddmac = <3300>;
			vsc8531,edge-slowdown = <7>;
			interrupts-extended = <&gpiog 0 IRQ_TYPE_EDGE_FALLING>;
			reg = <0>;
		};
	};
};

&sdhci1 {
	/delete-property/ cd-gpios;
	/delete-property/ wp-gpios;
	disable-wp;
	vmmc-supply = <&wlan_en_reg>;
	bus-width = <4>;
	non-removable;
	cap-power-off-card;
	keep-power-in-suspend;
	no-1-8-v;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	wlcore: wlcore@2 {
		status = "okay";
		compatible = "ti,wl1837";
		reg = <2>;
		interrupt-parent = <&gpiog>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
	};
};


&i2c1 {
	// Refdes: U32
	// Chip: MCP23018T-E/MJ
	// Datasheet: https://ww1.microchip.com/downloads/en/DeviceDoc/22103a.pdf
	gpio_expander_on_carrier: mirochip_gpio_expander_on_carrier@21 {
		status = "okay";
		compatible = "microchip,mcp23018";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-parent = <&gpio_expander>;
		interrupts = <4 IRQ_TYPE_LEVEL_LOW>, <5 IRQ_TYPE_LEVEL_LOW>; // GPIO_INI_A, GPIO_INIT_B
		interrupt-controller;
		#interrupt-cells=<2>;
		gpio-line-names =
			"NC", "HNDY_GPIO_1", "HNDY_GPIO_2", "HNDY_GPIO_3",
			"HNDY_GPIO_4", "HNDY_GPIO_5", "HNDY_GPIO_6", "HNDY_GPIO_7",
			"HNDY_GPIO_8", "HNDY_GPIO_9", "ETH2_EN", "RED_LED",
			"GRN_LED", "DISP1_IO0", "DISP1_IO2", "NC" ;
	};

	// Refdes: U23
	// Chip: 24WC32
	// DataSheet: https://www.st.com/resource/en/datasheet/m24c32-x.pdf
	eeprom_on_carrier: eeprom@51 {
		compatible = "atmel,24c32";
		pagesize = <32>;
		reg = <0x51>;
		status = "okay";
	};

	// The Audio Codec
	// Refdes: U15
	// Chip: SGTL5000XNLA3
	// Datasheet: https://www.nxp.com/docs/en/data-sheet/SGTL5000.pdf
	sgtl5000: audio-codec@0a {
		compatible = "fsl,sgtl5000";
		reg = <0x0a>;
		#sound-dai-cells = <0>;
		VDDA-supply = <&reg_3p3_vcc>;
		VDDIO-supply = <&reg_3p3_vcc>;
		VDDD-supply = <&reg_1p5v>;
		clocks = <&i2s0>;
		status = "okay";
		port {
			sgtl5000_ep: endpoint {
				remote-endpoint = <&i2s0_ep>;
			};
		};
	};
};

&uart3 {
	bluetooth: wl1837st {
		compatible = "ti,wl1837-st";
		enable-gpios = <&gpio_expander 2 GPIO_ACTIVE_HIGH>;
		max-speed = <912600>;
		status = "okay";
	};
};

&spi0 {
	// userland spidev support for headers and pins. we have 2 chip selects
	// CS1 and CS3 this all gets routed to HDR7
	spi_dev_0: spidev00@1 {
		compatible = "emac,spidev";
		reg = <1>;
	};
	spi_dev_1: spidev1@3 {
		compatible = "emac,spidev";
		reg = <3>;
	};
};

&sound {
	compatible = "nuvoton,ma35d1-audio-sgtl5000";
	label = "MA35D1-SGTL5000";
	dais = <&i2s0_port>;
	status = "okay";
	widgets =
		"Headphone", "Headphone Jack",
		"Microphone", "Mic Jack";
	routing =
		"Headphone Jack", "HP_OUT",
		"MIC_IN", "Mic Jack";
};

&i2s0 {
	status = "okay";
	i2s0_port: port {
		i2s0_ep: endpoint {
			remote-endpoint = <&sgtl5000_ep>;
			dai-format = "i2s";
			bitclock-master;
			frame-master;
			//  48000 * 256 = 12.288 MHz
			mclk-fs = <256>;
			// TODO clean this up after testing.
			system-clock-frequency = <12288000>;
			system-clock-direction-out;
		};
	};
};
